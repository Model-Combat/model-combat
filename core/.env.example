# Copy to .env. Only secrets and host overrides live here.
# Everything else (scoring weights, wave duration, runtime backend, etc.)
# is a code default in src/model_combat/config.py — change it there.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenCode Zen gateway key. Lets you run Kimi K2.6, GLM 5.1, Qwen 3.6,
# MiniMax M2.7, DeepSeek V4 etc. via the "opencode" provider. Get one at
# https://opencode.ai then add billing details.
# OPENCODE_API_KEY=...

# Optional. Set only if pointing the CLI at a non-default judge host.
# MODEL_COMBAT_JUDGE_URL=http://127.0.0.1:8000
